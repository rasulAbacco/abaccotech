generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 🟢 Users (auth)
model User {
  id           Int      @id @default(autoincrement())
  username     String
  email        String   @unique
  phone        String?
  password     String // hashed with bcrypt, never store plain text
  role         String   @default("user") // "user" | "admin"  -> default is ALWAYS "user"
  referralCode String?  @unique // auto-generated after creation, e.g. "ABARC001"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor Vendor? // the vendor/KYC details this user has submitted, if any
}

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       String   @unique
  paymentId     String? // nullable until payment success
  signature     String? // nullable until payment success
  customerEmail String?
  customerName  String?
  phoneNumber   String? // yes, add this
  amount        Int
  status        String   @default("PENDING") // start as pending
  plan          String? // ✅ store selected plan name
  planPrice     Int? // ✅ store plan base price
  addOns        String? // ✅ store JSON array of add-ons
  createdAt     DateTime @default(now())
}

// 🟢 Vendor Registration
model Vendor {
  id         Int     @id @default(autoincrement())
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     Int?    @unique // links this vendor submission to the logged-in user who submitted it
  fullName   String
  phone      String
  email      String
  websiteUrl String? // optional company/website url

  // 🪪 Identity Details (KYC)
  aadhaarNumber String? // 12-digit Aadhaar number
  panNumber     String? // 10-character PAN (e.g. ABCDE1234F)

  // 🏦 Bank Details
  bankAccountNumber String?
  bankName          String?
  ifscCode          String?
  branchName        String?

  status    String       @default("PENDING") // PENDING | APPROVED | REJECTED
  files     VendorFile[]
  referrals Referral[] // 🆕 users referred by this vendor via their referral code
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// 🟢 Files uploaded by a Vendor (supports single or multiple uploads)
// docType lets us tag what each uploaded file is (Aadhaar copy, PAN copy, other document, etc.)
model VendorFile {
  id        Int      @id @default(autoincrement())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId  Int
  fileName  String // original file name
  filePath  String // path/url where file is stored
  fileType  String? // mimetype, e.g. application/pdf, image/png
  fileSize  Int? // size in bytes
  docType   String   @default("OTHER") // AADHAAR | PAN | BANK_PROOF | OTHER
  createdAt DateTime @default(now())
}

// 🆕 Referral — a user who signed up on an external site (Bounce Cure, School CRM, etc.)
// using a vendor's referral code. Abacco Tech is the system of record for these leads.

model Referral {
  id           Int     @id @default(autoincrement())
  vendor       Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId     Int
  referralCode String
  website      String
  userName     String
  email        String?
  phone        String? // 🔄 was required — now optional (see note above)
  plan         String?
  status       String  @default("TRIAL")
  externalId   String? // 🆕 the referred user's id on the source site — reliable dedup key for synced rows

  // 🆕 Payment/subscription detail fields — approved for the Referral
  // Dashboard feature. Populated by services/motorDeskSync.service.js from
  // Motor Desk's GET /api/abacco/referrals payload. Every field here is
  // optional/nullable on purpose: sources that don't provide this data
  // (e.g. School CRM, via services/schoolSync.service.js, which was NOT
  // modified) simply leave these null, and nothing else breaks.
  customerName    String?
  companyName     String?
  billingPeriod   String?
  amount          Float?
  originalAmount  Float?
  discountAmount  Float?
  discountPercent Float?
  paymentId       String?
  orderId         String?
  subscriptionId  String?
  paidAt          DateTime?
  expiryDate      DateTime?
  nextBillingDate DateTime?
  trialEndDate    DateTime?
  isTrial         Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔄 (website, phone) is no longer a safe uniqueness guarantee on its own
  // since phone can now be null for many rows — Postgres allows multiple
  // NULLs under a unique index, so this constraint is effectively inert for
  // Bounce Cure rows now, but still protects sources that do supply a phone.
  @@unique([website, phone])
  @@unique([website, externalId]) // 🆕 the real dedup key for synced rows
  @@index([vendorId])
  @@index([referralCode])
}

// 2. Unchanged from before — remembers the last successful sync timestamp.
model SyncState {
  key   String @id
  value String
}

// ─────────────────────────────────────────────────────────────
// 🆕 WhatsApp Campaigns (Meta WhatsApp Cloud API)
// Credentials (token, phone number id, WABA id, app secret) live ONLY in
// server/.env — never in the database or the React app.
// ─────────────────────────────────────────────────────────────

// A person we can message. Phone is stored in E.164 digits without "+"
// (e.g. "919876543210"), which is exactly what the Cloud API expects.
model WhatsAppContact {
  id         Int       @id @default(autoincrement())
  phone      String    @unique
  name       String?
  tag        String? // import label / segment, e.g. "supermarkets-oct"
  optedIn    Boolean   @default(true) // only import contacts who agreed to receive messages
  optedOutAt DateTime? // set when they reply STOP or an admin opts them out
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  recipients WhatsAppCampaignRecipient[]

  @@index([tag])
}

// 🆕 Local copy of the message templates that live in Meta (WhatsApp
// Manager). Filled by "Sync from Meta" — never created by hand here.
// Stores each template's structure so the dashboard can build the right
// form (header media / variables / buttons) for ANY template.
model WhatsAppTemplate {
  id              Int      @id @default(autoincrement())
  metaTemplateId  String   @unique // template id in Meta
  name            String
  language        String // e.g. "en", "en_US"
  category        String? // MARKETING | UTILITY | AUTHENTICATION
  status          String // APPROVED | PENDING | REJECTED | PAUSED | DISABLED | DELETED (deleted = gone from Meta)
  parameterFormat String   @default("POSITIONAL") // POSITIONAL ({{1}}) | NAMED ({{customer_name}})
  headerFormat    String? // TEXT | IMAGE | VIDEO | DOCUMENT | LOCATION | null (no header)
  headerText      String? // header text when headerFormat = TEXT
  headerVariables Json? // variable names inside a TEXT header, e.g. ["1"]
  bodyText        String?
  bodyVariables   Json? // e.g. ["1","2"] or ["customer_name","offer"]
  footerText      String?
  buttons         Json? // [{ index, type, text, url?, hasVariable }]
  components      Json // raw components exactly as Meta returned them
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns WhatsAppCampaign[]

  @@unique([name, language])
  @@index([status])
}

model WhatsAppCampaign {
  id             Int               @id @default(autoincrement())
  name           String
  template       WhatsAppTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId     Int?
  templateName   String // copied from the template at creation (kept even if the template is later deleted)
  languageCode   String            @default("en")
  headerImageUrl String? // public HTTPS link for IMAGE / VIDEO / DOCUMENT headers
  headerParams   Json? // values for TEXT-header variables
  bodyParams     Json? // ["{{name}}", "20% off"] — {{name}} is replaced per contact
  buttonParams   Json? // { "0": "summer-sale" } — values for dynamic URL / copy-code buttons, keyed by button index
  audienceTag    String? // null = all opted-in contacts
  status         String            @default("DRAFT") // DRAFT | SCHEDULED | SENDING | PAUSED | COMPLETED | FAILED | CANCELLED
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      String?
  createdById    Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  recipients WhatsAppCampaignRecipient[]

  @@index([status, scheduledAt])
}

// One row per (campaign, contact) — the unique index is the duplicate-send guard.
model WhatsAppCampaignRecipient {
  id            Int              @id @default(autoincrement())
  campaign      WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId    Int
  contact       WhatsAppContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId     Int
  phone         String
  status        String           @default("PENDING") // PENDING | QUEUED | ACCEPTED | SENT | DELIVERED | READ | FAILED | SKIPPED | CANCELLED
  messageId     String?          @unique // wamid returned by Meta
  attempts      Int              @default(0)
  nextAttemptAt DateTime? // 🆕 retry back-off for temporary Meta errors
  errorCode     String?
  errorText     String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

// Raw webhook status events, kept for auditing and to ignore duplicates
// (Meta can deliver the same event more than once).
model WhatsAppWebhookEvent {
  id          Int       @id @default(autoincrement())
  eventKey    String    @unique // `${messageId}:${status}` or `msg:${incomingId}`
  messageId   String?
  status      String?
  payload     Json
  processedAt DateTime? // 🆕 null = not yet matched to a campaign recipient
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
}
